# Salin file ini menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# JANGAN commit .env.local dan jangan membagikan nilainya.

# Alamat publik website, tanpa garis miring di akhir. Contoh: https://roudlotut-tholibat.vercel.app
NEXT_PUBLIC_SITE_URL=

# Koneksi PostgreSQL Supabase (Project Settings > Database > Connection string).
# Untuk Vercel gunakan "Transaction pooler" (port 6543). Hanya dipakai di server.
DATABASE_URL=

# Rahasia penanda tangan sesi admin. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Supabase Storage (foto berita, galeri, dan pengaturan). Hanya dipakai di server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
